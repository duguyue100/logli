# Copy to .env and fill in. .env is gitignored.
#
# Domain that Caddy obtains a Let's Encrypt cert for. Must resolve to this VPS.
EDITOR_DOMAIN=my-domain.com

# basic_auth credentials.
#
# The hash must be SINGLE-QUOTED in .env, otherwise Compose treats the "$" in
# the bcrypt hash as a variable and mangles it. Generate it with:
#
#   HASH=$(docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-strong-password')
#   printf "EDITOR_PASSWORD_HASH='%s'\n" "$HASH" >> .env
#
# The result must look like:
#   EDITOR_PASSWORD_HASH='$2a$14$....'
EDITOR_USER=duguyue100
EDITOR_PASSWORD_HASH=

# Owner the repo is chowned to after each write. Use the ids of the account
# that owns the checkout on the VPS: `id -u` / `id -g`. Root is 0 / 0.
EDITOR_UID=0
EDITOR_GID=0

# Git author for commits made by the editor.
GIT_NAME=duguyue100
GIT_EMAIL=duguyue100@users.noreply.github.com
