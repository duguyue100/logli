{$EDITOR_DOMAIN} {
	encode gzip

	basic_auth {
		{$EDITOR_USER} {$EDITOR_PASSWORD_HASH}
	}

	redir /logli-editor /logli-editor/ 308

	handle_path /logli-editor/* {
		reverse_proxy editor:8000
	}

	# index.html uses root-absolute URLs; keep these at root.
	handle /api/* {
		reverse_proxy editor:8000
	}
	handle /assets/images/* {
		reverse_proxy editor:8000
	}
}
