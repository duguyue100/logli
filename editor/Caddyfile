{$EDITOR_DOMAIN} {
	encode gzip

	redir /logli-editor /logli-editor/ 308

	handle_path /logli-editor/* {
		basic_auth {
			{$EDITOR_USER} {$EDITOR_PASSWORD_HASH}
		}
		reverse_proxy editor:8000
	}

	# Other services on this domain add their own handle blocks above this.
	handle {
		respond 404
	}
}
